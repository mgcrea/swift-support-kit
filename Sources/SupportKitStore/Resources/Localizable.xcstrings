{
  "sourceLanguage": "en",
  "strings": {
    "No previous purchase was found on this Apple Account.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Apple Account wurde kein früherer Kauf gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ninguna compra anterior en esta Cuenta de Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun acquisto precedente trovato su questo Account Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat précédent n’a été trouvé sur ce compte Apple."
          }
        }
      }
    },
    "The App Store did not return the purchase. Try again in a moment.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store hat den Kauf nicht zurückgegeben. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no ha devuelto la compra. Vuelve a intentarlo en un momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store non ha restituito l’acquisto. Riprova tra poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store n’a pas renvoyé l’achat. Réessayez dans un instant."
          }
        }
      }
    },
    "The purchase could not be verified: %@": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht überprüft werden: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar la compra: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare l’acquisto: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’a pas pu être vérifié : %@"
          }
        }
      }
    }
  },
