    "Thanks for buying Pro. I read every message, and good ideas ship fast.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du Pro gekauft hast. Ich lese jede Nachricht, und gute Ideen landen schnell in der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por comprar Pro. Leo todos los mensajes, y las buenas ideas llegan rápido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per aver acquistato Pro. Leggo ogni messaggio, e le buone idee arrivano presto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci d’avoir acheté Pro. Je lis chaque message, et les bonnes idées sont vite intégrées."
          }
        }
      }
    },
    "What should %@ do better?": {
