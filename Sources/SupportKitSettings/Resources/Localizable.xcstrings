    "Bought once: no subscription, no paid upgrades. Shared with your family through Family Sharing, and on every device signed in to your Apple Account.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal gekauft: kein Abo, keine kostenpflichtigen Upgrades. Über die Familienfreigabe mit deiner Familie geteilt und auf jedem Gerät, das mit deinem Apple Account angemeldet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprado una vez: sin suscripción ni actualizaciones de pago. Compartido con tu familia mediante En familia, y en todos los dispositivos con tu Cuenta de Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquistato una volta: nessun abbonamento, nessun aggiornamento a pagamento. Condiviso con la tua famiglia tramite In famiglia, e su ogni dispositivo con il tuo Account Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acheté une fois : pas d’abonnement, pas de mise à niveau payante. Partagé avec votre famille grâce au partage familial, et sur tous les appareils connectés à votre compte Apple."
          }
        }
      }
    }
  },
  "version": "1.0"
