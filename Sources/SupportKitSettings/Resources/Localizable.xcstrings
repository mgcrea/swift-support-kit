    "macOS is running this copy from a temporary location that will be gone next time. Move the app to your Applications folder and open it from there to launch it at login.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS exécute cette copie depuis un emplacement temporaire qui aura disparu la prochaine fois. Déplacez l'app dans votre dossier Applications et ouvrez-la depuis là pour l'ouvrir à l'ouverture de session."
          }
        }
      }
    },
